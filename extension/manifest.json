{
  "manifest_version": 3,
  "name": "Official Lists for Letterboxd",
  "version": "1.0.0",
  "description": "Shows which Letterboxd official lists include a film, on the film's page. Not affiliated with Letterboxd.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://letterboxd.com/film/*"],
      "js": ["settings.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
